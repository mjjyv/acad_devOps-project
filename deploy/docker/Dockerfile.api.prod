# ============================================================================
# MULTI-STAGE DOCKERFILE - PRODUCTION BACKEND API RUNNER
# Kích thước mục tiêu: < 100MB
# ============================================================================

# Stage 1: Build environment
FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate
WORKDIR /app

# Copy root workspace configurations
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui-tokens/package.json ./packages/ui-tokens/
COPY packages/auth-client/package.json ./packages/auth-client/
COPY packages/tree-virtualizer/package.json ./packages/tree-virtualizer/
COPY services/auth/package.json ./services/auth/
COPY services/community/package.json ./services/community/
COPY apps/api/package.json ./apps/api/

# Cài đặt toàn bộ dependencies phục vụ compile
RUN pnpm install --frozen-lockfile

# Copy mã nguồn
COPY packages/ ./packages/
COPY services/ ./services/
COPY apps/api/ ./apps/api/

# Biên dịch TypeScript sang JavaScript
RUN pnpm --filter @acad/api run build

# Stage 2: Production Minimal Runner
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV API_PORT=8080

# Chạy dưới tài khoản non-root để đảm bảo an ninh
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/services ./services
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

USER appuser
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["node", "apps/api/dist/server.js"]
