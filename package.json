{
  "name": "acad-devops-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "High-throughput Discussion Engine & Social Architecture Monorepo (v3 Clean Foundation)",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter \"./services/*\" --if-present run build && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @acad/api-gateway --if-present run test:integration",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present run build",
    "build:libs": "pnpm -r --filter \"./packages/*\" --filter \"./services/*\" --if-present run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  }
}
