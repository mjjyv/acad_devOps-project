# ============================================================================
# ACAD COMMUNITY & SOCIAL PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành .env hoặc .env.local và điền giá trị tương ứng
# ============================================================================

# 1. MÔI TRƯỜNG CHẠY (RUNTIME ENVIRONMENT)
NODE_ENV=development
API_PORT=8080
WEB_PORT=3000

# 2. HẠ TẦNG CƠ SỞ DỮ LIỆU POSTGRESQL 16
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres_secret_password@localhost:5432/acad_community_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secret_password
DB_NAME=acad_community_dev

# 3. HẠ TẦNG BỘ NHỚ ĐỆM & STATE REDIS 7
# Redis Volatile Cache & Persistent Session Stream
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. THIẾT LẬP MẬT MÃ & BẢO MẬT PHÂN HỆ AUTH
# Khóa bí mật ký số JWT HMAC-SHA256 (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=acad_super_secure_jwt_hmac_secret_key_change_me_in_production_32chars!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
TOKEN_ROTATION_GRACE_PERIOD_MS=30000

# 5. DỊCH VỤ LƯU TRỮ ĐA PHƯƠNG TIỆN ZERO-HOP (CLOUDFLARE R2 / AWS S3)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=acad-media-assets-dev
R2_PUBLIC_DOMAIN=https://cdn.acad-community.dev

# 6. ĐỘNG CƠ TÌM KIẾM MEILISEARCH (TÙY CHỌN)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your_meilisearch_master_key

# 7. QUAN SÁT & THEO DÕI LỖI (SENTRY & PROMETHEUS)
SENTRY_DSN=
METRICS_PORT=9090
