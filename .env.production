# ==============================================================================
# ACAD DEVOPS FULLSTACK PLATFORM - PRODUCTION CONFIGURATION
# File: .env.production
# ==============================================================================

# 1. RUNTIME PORTS
NODE_ENV=production
PORT=10000
API_PORT=10000
WEB_PORT=3000

# 2. DATABASE POSTGRESQL 16 (Lưu trữ cục bộ trên máy qua Podman volume .data/postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acad_dev?sslmode=disable
DATABASE_SSL=false

# 3. REDIS 7 (Lưu trữ cục bộ trên máy qua Podman volume .data/redis)
REDIS_URL=redis://localhost:6379

# 4. BẢO MẬT PHÂN HỆ AUTH & JWT (Tối thiểu 32 ký tự ngẫu nhiên bảo mật cao)
JWT_SECRET=acad_super_secure_production_secret_key_2026_at_least_32_chars!

# 5. ĐỊNH TUYẾN TÊN MIỀN & REVERSE PROXY
INTERNAL_API_URL=http://127.0.0.1:10000
CORS_ORIGIN=*
CORS_ALLOWED_ORIGINS=*
